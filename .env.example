# 設定の見本。scripts/setup.sh が .env にコピーするので、.env の方を書き換える(.env は GitHub に上げない)

# 子どものよび名。「さん」は自動でつく。空なら名前では呼ばない
AI_FRIEND_CHILD_NAME=

# 子どもの学年(例: 小学2年生)。話し方の目安にする
AI_FRIEND_CHILD_GRADE=小学生

# キャラクターの名前(画面の「せってい」でも変えられる)
AI_FRIEND_CHARACTER_NAME=あや

# 返事を作る Ollama のモデル
AI_FRIEND_MODEL=gemma4:12b

# Mac のブラウザで開くポート(http)と、iPhone から開くポート(https)
AI_FRIEND_PORT=8765
AI_FRIEND_LAN_PORT=8766
